{
  "name": "echomoss",
  "version": "0.2.0",
  "description": "A local-first Spotify companion that grows a pixel terrarium from listening sessions.",
  "author": "Avexzz",
  "license": "MIT",
  "keywords": [
    "spotify",
    "tauri",
    "pixel-art",
    "desktop-companion",
    "local-first",
    "preact",
    "terrarium"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build:web": "npm run typecheck && vite build",
    "build": "npm run typecheck && tauri build",
    "build:debug": "npm run typecheck && tauri build --debug",
    "tauri": "tauri",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.16.5",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}

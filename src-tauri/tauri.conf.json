{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "echomoss",
  "version": "0.2.0",
  "identifier": "dev.echomoss.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "echomoss",
        "width": 1120,
        "height": 790,
        "minWidth": 800,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#04090d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https://*.scdn.co https://*.spotifycdn.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
